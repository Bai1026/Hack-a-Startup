     "bbox": [
      76.0,
      176.68,
      465.83,
      188.48
     ]
    },
    {
     "line_id": "POL-p1-L7",
     "line": 7,
     "text": "Conservative therapy: non-surgical treatment, including physical therapy, exercise, and medication.",
     "style": "body",
     "bbox": [
      76.0,
